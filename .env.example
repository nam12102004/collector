# Copy to .env for local development. Replace blank secrets with local-only values.

# Compose/image identity
COMPOSE_PROJECT_NAME=attendance-collector
IMAGE_REGISTRY=ghcr.io/aubot-it
IMAGE_TAG=local
EDGE_BIND_ADDRESS=127.0.0.1
LOCAL_APP_PORT=4210
LOCAL_DB_PORT=5434
STAGING_APP_PORT=5787
PRODUCTION_APP_PORT=5188

# Local PostgreSQL / pgAdmin
DB_NAME=attendanceCollector
DB_USER=attendanceCollector
DB_PASSWORD=
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ALLOWED_HOSTS=*
AUTOMAPPER_LICENSE_KEY=

# OIDC / local Keycloak
OIDC_ISSUER=http://localhost:8081/realms/attendance-collector
OIDC_METADATA_ADDRESS=http://host.docker.internal:8081/realms/attendance-collector/.well-known/openid-configuration
OIDC_CLIENT_ID=attendance-collector-webapp
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=attendanceCollector-api
OIDC_VALIDATE_AUDIENCE=true
OIDC_REDIRECT_URI=http://localhost:4210/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:4210/login
OIDC_SCOPES=openid profile email
OIDC_REQUIRE_HTTPS_METADATA=false

# Bootstrap admin identity
BOOTSTRAP_ENABLED=
BOOTSTRAP_ADMIN_EMAIL=admin@aubot.local
BOOTSTRAP_ADMIN_EXTERNAL_SUBJECT=7b978450-848e-4b7f-830c-c8feb5fe9db2

# Optional local Keycloak admin credentials
KEYCLOAK_HOST_PORT=8081
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_COLLECTOR_ADMIN_PASSWORD=

# Optional OpenTelemetry exporter; an empty endpoint disables export
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=attendanceCollector-api
OTEL_SERVICE_VERSION=local
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=

# Scheduled PostgreSQL backup settings
BACKUP_ENABLED=false
BACKUP_CRON=0 0 2 * * ?
BACKUP_TIME_ZONE=Asia/Bangkok
BACKUP_RETENTION_DAYS=7
BACKUP_MINIMUM_INTERVAL_HOURS=23
BACKUP_RETRY_COUNT=3
BACKUP_RETRY_DELAY_SECONDS=60
BACKUP_COMMAND_TIMEOUT_MINUTES=120

# Collector key management
COLLECTOR_INTEGRATION_ENABLED=true
COLLECTOR_ALLOW_DEVELOPMENT_HTTP=true

# Optional MockDevice simulator (docker-compose.mock-device.yml)
MOCK_DEVICE_DB_NAME=mockDevice
MOCK_DEVICE_DB_USER=mockDevice
MOCK_DEVICE_DB_PASSWORD=
MOCK_DEVICE_INGESTION_API_KEY=
MOCK_DEVICE_COLLECTOR_URL=http://api:8080/
MOCK_DEVICE_CONNECT_HOST=mock-device
MOCK_DEVICE_PORT=4300
MOCK_DEVICE_DB_VOLUME=attendance-mock-device-data
ATTENDANCE_NETWORK_NAME=attendance-collector-network
