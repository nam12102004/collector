{
  "CollectorIntegration": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=attendanceCollector;Username=attendanceCollector;Password=local-dev-only"
  },
  "Oidc": {
    "Issuer": "http://localhost:8080/realms/aubot",
    "MetadataAddress": "http://localhost:8080/realms/aubot/.well-known/openid-configuration",
    "ClientId": "hrm-webapp",
    "Audience": "hrm-api",
    "RedirectUri": "http://localhost:4210/auth/callback",
    "PostLogoutRedirectUri": "http://localhost:4210/login",
    "Scopes": "openid profile email",
    "ValidateAudience": true,
    "RequireHttpsMetadata": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}


